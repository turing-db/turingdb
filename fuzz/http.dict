# ============================================================
# TuringDB HTTP parser dictionary for AFL++
# Extracted from HTTPParser.h, UriParser.h, DBURIParser.h
# ============================================================

# --- HTTP methods ---
"GET"
"POST"
"GET "
"POST "

# --- HTTP versions ---
"HTTP/1.0"
"HTTP/1.1"
" HTTP/1.1\x0d\x0a"

# --- Line endings ---
"\x0d\x0a"
"\x0d\x0a\x0d\x0a"

# --- Headers ---
"Host: "
"Host: localhost"
"Content-Length: "
"content-length: "
"Content-Length: 0"
"Content-Length: 1"
"Content-Length: 100"
"Content-Type: "
"Content-Type: application/turing-proto"
"Authorization: "
"Authorization: Bearer "

# --- TuringDB endpoints (from DBURIParser.h) ---
"/query"
"/query/"

# --- URI query parameters ---
"?"
"&"
"="
"?graph="
"?commit="
"?change="

# --- URI valid chars (from HTTPParser::isURIValid) ---
"/"
"_"
"-"
"."
";"

# --- Common graph names ---
"default"
"simpledb"

# --- Binary request bodies: [u32 query length][query][u32 parameter map length] ---
"\x00\x00\x00\x00"
"\x00\x00\x00\x00\x00\x00\x00\x00"
"\x12\x00\x00\x00MATCH (n) RETURN n\x00\x00\x00\x00"

# --- Content-Length edge cases ---
"Content-Length: -1"
"Content-Length: 0"
"Content-Length: 999999999999999999"
"Content-Length: 18446744073709551615"

# --- Partial/malformed requests ---
"GET / HTTP/1.1\x0d\x0aHost: localhost\x0d\x0a\x0d\x0a"
"POST /query?graph=default HTTP/1.1\x0d\x0aContent-Length: 0\x0d\x0a\x0d\x0a"

# --- Boundary tokens ---
" "
"\x0d"
"\x0a"
"\x09"
"\x00"
