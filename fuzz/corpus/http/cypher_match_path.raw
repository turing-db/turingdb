POST /query?graph=default HTTP/1.1
Host: localhost:6666
Accept-Encoding: gzip, deflate
Connection: keep-alive
User-Agent: python-httpx/0.28.1
Accept: application/json
Content-Type: application/json
Content-Length: 98

MATCH (a:Person)-[:KNOWS]->(b:Person)-[:INTERESTED_IN]->(c:Interest) RETURN a.name, b.name, c.name