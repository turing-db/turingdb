POST /query?graph=default&change=1f HTTP/1.1
Host: localhost:6666
Accept-Encoding: gzip, deflate
Connection: keep-alive
User-Agent: python-httpx/0.28.1
Accept: application/json
Content-Type: application/json
Content-Length: 539

MATCH (person:Person {id: 4398046511333 })-[:KNOWS]-(friend:Person), (friend)<-[:HAS_CREATOR]-(post:Post)-[:HAS_TAG]->(tag) WITH DISTINCT tag, post WITH tag, CASE WHEN datetime('2010-06-01') <= post.creationDate < datetime('2010-06-30') THEN 1 ELSE 0 END AS valid, CASE WHEN post.creationDate < datetime('2010-06-01') THEN 1 ELSE 0 END AS inValid WITH tag, sum(valid) AS postCount, sum(inValid) AS inValidPostCount WHERE postCount>0 AND inValidPostCount=0 RETURN tag.name AS tagName, postCount ORDER BY postCount DESC, tagName ASC LIMIT 10